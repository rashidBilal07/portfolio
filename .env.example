# Copy to .env and fill in. The admin surface stays disabled (503) until
# BOTH of these are set — it never falls back to an open state.
#
# QUOTE any value containing '#': an unquoted # starts a comment, so
# ADMIN_PASSWORD=abc#1 would silently be read as just 'abc'.

# The password you type at /admin/login. Make it long.
ADMIN_PASSWORD="change-me"
# Signs the admin session cookie. At least 16 chars; 32+ recommended.
# Generate one:  openssl rand -base64 32
AUTH_SECRET="change-me-at-least-16-chars"

# Your canonical URL. Used for metadata, sitemap.xml and robots.txt.
SITE_URL=https://example.com

# Storage for the /admin content store.
#
# On Vercel: link a Blob store to the project (Storage > Create > Blob) and
# Vercel injects BLOB_READ_WRITE_TOKEN automatically — you do not set it here.
# Whenever that variable is present the app stores content in Vercel Blob
# instead of on disk, which is what makes /admin saves work in production.
# Leave it unset locally and the app writes ./content.json instead.
# BLOB_READ_WRITE_TOKEN=

# Optional: where the editable content JSON lives when using the FILESYSTEM
# backend (i.e. no BLOB_READ_WRITE_TOKEN).
# Defaults to ./content.json in the project root. On a container host, point
# this at a mounted volume so edits survive a redeploy.
# CONTENT_STORE_PATH=/data/content.json
